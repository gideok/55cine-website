# MS SQL Server — 실제 값은 .env 에만 저장 (git 커밋 금지)
# Prisma 스타일 URL 또는 아래 개별 변수 중 하나 사용
# DATABASE_URL=sqlserver://host:1433;database=cine55;user=...;password=...;encrypt=true;trustServerCertificate=true

# 개별 변수 (DATABASE_URL 미설정 시)
# DB_SERVER=your-host
# DB_PORT=1433
# DB_DATABASE=cine55
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

# API 서버
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=/api/v1

# 로컬: DB 없이 정적 JSON 픽스처로 시간표 응답 (개발용)
# SCHEDULE_USE_MOCK=true

# 타임존 (상영 주간 계산)
TZ=Asia/Seoul
