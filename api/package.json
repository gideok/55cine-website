{
  "name": "55cine-api",
  "version": "0.1.0",
  "private": true,
  "description": "55cine website backend API (MS SQL Server)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/run-all-sql.mjs",
    "db:inspect": "node scripts/inspect-db.mjs",
    "db:seed:web-program": "node scripts/seed-web-program.mjs",
    "db:seed:content": "node scripts/seed-web-program-content.mjs",
    "db:migrate:nowshowing-archive": "node scripts/migrate-nowshowing-archive.mjs",
    "db:sync:schedule-images": "node scripts/sync-schedule-page-images.mjs",
    "db:generate:thumbs": "node scripts/generate-wp-thumbnails.mjs",
    "db:admin:close-stale-now-playing": "node scripts/admin-close-stale-now-playing.mjs --execute",
    "db:migrate:special": "node scripts/migrate-special-program.mjs --execute",
    "db:backfill:special-info": "node scripts/migrate-special-program.mjs --backfill-info --execute",
    "db:sync:special": "node scripts/sync-special-from-55cine.mjs --sync-page --execute",
    "db:remigrate:special": "node scripts/sync-special-from-55cine.mjs --sync-category --from-page=1 --to-page=35 --purge-exhibition --execute",
    "db:migrate:magazine": "node scripts/migrate-magazine.mjs --execute",
    "db:sync:magazine": "node scripts/sync-magazine-from-tistory.mjs --empty-only --execute",
    "db:import:magazine": "node scripts/sync-magazine-from-tistory.mjs --import-missing --execute",
    "db:sync:magazine:serial": "node scripts/sync-magazine-from-tistory.mjs --section=serial --execute",
    "db:sync:magazine:gv-moment": "node scripts/sync-magazine-from-tistory.mjs --section=gv-moment --execute"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "mssql": "^11.0.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
